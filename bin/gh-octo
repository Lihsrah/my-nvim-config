#!/usr/bin/env bash
set -euo pipefail

real_gh="${GH_REAL_BIN:-$(command -v gh 2>/dev/null || echo gh)}"

slurp_requested=0
args=()

for arg in "$@"; do
  if [[ "$arg" == "--slurp" ]]; then
    slurp_requested=1
    continue
  fi
  args+=("$arg")
done

if (( slurp_requested == 0 )); then
  exec "$real_gh" "${args[@]}"
fi

# Only emulate slurp for API calls. For other commands, just drop the flag.
if [[ "${args[0]-}" != "api" ]]; then
  exec "$real_gh" "${args[@]}"
fi

tmp_out="$(mktemp)"
tmp_err="$(mktemp)"
cleanup() {
  rm -f "$tmp_out" "$tmp_err"
}
trap cleanup EXIT

if ! "$real_gh" "${args[@]}" >"$tmp_out" 2>"$tmp_err"; then
  cat "$tmp_err" >&2
  exit 1
fi

if [[ -s "$tmp_err" ]]; then
  cat "$tmp_err" >&2
fi

python3 - "$tmp_out" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = f.read()

decoder = json.JSONDecoder()
index = 0
length = len(data)
items = []

try:
    while True:
        while index < length and data[index] in ' \t\n\r':
            index += 1
        if index >= length:
            break
        obj, index = decoder.raw_decode(data, index)
        items.append(obj)
except json.JSONDecodeError:
    sys.stdout.write(data)
    sys.exit(0)

json.dump(items, sys.stdout, separators=(",", ":"))
PY
